@model GestionFormation.Models.Module

@{
    ViewData["Title"] = "Supprimer un Module";
}

<h1>Supprimer le Module</h1>

<h3>Êtes-vous sûr de vouloir supprimer ce module ?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Titre</dt>
        <dd class="col-sm-10">@Model.Titre</dd>

        <dt class="col-sm-2">Formation</dt>
        <dd class="col-sm-10">@Model.Formation?.Titre</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Supprimer</button>
        <a asp-action="Index" class="btn btn-secondary">Annuler</a>
    </form>
</div>