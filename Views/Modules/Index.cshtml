@model IEnumerable<GestionFormation.Models.Module>

@{
    ViewData["Title"] = "Modules";
}

<h1>Liste des Modules</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Ajouter un module</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Titre</th>
            <th>Ordre</th>
            <th>Formation</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Titre</td>
                <td>@item.Ordre</td>
                <td>@item.Formation?.Titre</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Modifier</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Détails</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>