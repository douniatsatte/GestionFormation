@model GestionFormation.Models.Module

@{
    ViewData["Title"] = "Détails du Module";
}

<h1>Détails du Module</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">Titre</dt>
        <dd class="col-sm-10">@Model.Titre</dd>

        <dt class="col-sm-2">Ordre</dt>
        <dd class="col-sm-10">@Model.Ordre</dd>

        <dt class="col-sm-2">Contenu</dt>
        <dd class="col-sm-10">@Model.Contenu</dd>

        <dt class="col-sm-2">Formation</dt>
        <dd class="col-sm-10">@Model.Formation?.Titre</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Modifier</a> |
    <a asp-action="Index">Retour à la liste</a>
    <a asp-controller="Avatar" asp-action="Presenter" asp-route-id="@Model.Id" class="btn btn-success mb-3">
        Démarrer avec le Formateur IA
    </a>
</div>