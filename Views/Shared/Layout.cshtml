<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GestionFormation</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark shadow-sm" style="background-color:#2c3e50;">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    📚 GestionFormation
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Categories" asp-action="Index">Catégories</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Formations" asp-action="Index">Formations</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Formateurs" asp-action="Index">Formateurs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Modules" asp-action="Index">Modules</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Modalites" asp-action="Index">Modalités</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Apprenants" asp-action="Index">Apprenants</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Inscriptions" asp-action="Index">Inscriptions</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-3">
        <div class="container">
            &copy; 2026 - GestionFormation - Plateforme de gestion des formations
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>