@model IEnumerable<GestionFormation.Models.Formation>

@{
    ViewData["Title"] = "Formations";
}

<h1>Liste des Formations</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Ajouter une formation</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Titre</th>
            <th>Catégorie</th>
            <th>Formateur</th>
            <th>Date début</th>
            <th>Date fin</th>
            <th>Prix</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Titre</td>
                <td>@item.Categorie?.Nom</td>
                <td>@item.Formateur?.Nom @item.Formateur?.Prenom</td>
                <td>@item.DateDebut.ToShortDateString()</td>
                <td>@item.DateFin.ToShortDateString()</td>
                <td>@item.Prix DH</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Modifier</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Détails</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>