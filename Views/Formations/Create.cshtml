@model GestionFormation.Models.Formation

@{
    ViewData["Title"] = "Ajouter une Formation";
}

<h1>Ajouter une Formation</h1>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="Titre" class="control-label"></label>
        <input asp-for="Titre" class="form-control" />
        <span asp-validation-for="Titre" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Description" class="control-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="form-group mb-3">
        <label asp-for="DateDebut" class="control-label"></label>
        <input asp-for="DateDebut" class="form-control" type="date" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="DateFin" class="control-label"></label>
        <input asp-for="DateFin" class="form-control" type="date" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Prix" class="control-label"></label>
        <input asp-for="Prix" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="CategorieId" class="control-label"></label>
        <select asp-for="CategorieId" class="form-control" asp-items="ViewBag.CategorieId">
            <option value="">-- Choisir une catégorie --</option>
        </select>
    </div>

    <div class="form-group mb-3">
        <label asp-for="FormateurId" class="control-label"></label>
        <select asp-for="FormateurId" class="form-control" asp-items="ViewBag.FormateurId">
            <option value="">-- Aucun formateur --</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Créer</button>
    <a asp-action="Index" class="btn btn-secondary">Retour à la liste</a>
</form>