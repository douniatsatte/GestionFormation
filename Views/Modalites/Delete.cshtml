@model GestionFormation.Models.Modalite

@{
    ViewData["Title"] = "Supprimer une Modalité";
}

<h1>Supprimer la Modalité</h1>

<h3>Êtes-vous sûr de vouloir supprimer cette modalité ?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Titre</dt>
        <dd class="col-sm-10">@Model.Titre</dd>

        <dt class="col-sm-2">Type</dt>
        <dd class="col-sm-10">@Model.Type</dd>

        <dt class="col-sm-2">Module</dt>
        <dd class="col-sm-10">@Model.Module?.Titre</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Supprimer</button>
        <a asp-action="Index" class="btn btn-secondary">Annuler</a>
    </form>
</div>