@model GestionFormation.Models.Inscription

@{
    ViewData["Title"] = "Détails de l'Inscription";
}

<h1>Détails de l'Inscription</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">Apprenant</dt>
        <dd class="col-sm-10">@Model.Apprenant?.Nom @Model.Apprenant?.Prenom</dd>

        <dt class="col-sm-2">Formation</dt>
        <dd class="col-sm-10">@Model.Formation?.Titre</dd>

        <dt class="col-sm-2">Date d'inscription</dt>
        <dd class="col-sm-10">@Model.DateInscription.ToShortDateString()</dd>

        <dt class="col-sm-2">Statut</dt>
        <dd class="col-sm-10">@Model.Statut</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Modifier</a> |
    <a asp-action="Index">Retour à la liste</a>
</div>