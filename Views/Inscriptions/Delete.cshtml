@model GestionFormation.Models.Inscription

@{
    ViewData["Title"] = "Supprimer une Inscription";
}

<h1>Supprimer l'Inscription</h1>

<h3>Êtes-vous sûr de vouloir supprimer cette inscription ?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Apprenant</dt>
        <dd class="col-sm-10">@Model.Apprenant?.Nom @Model.Apprenant?.Prenom</dd>

        <dt class="col-sm-2">Formation</dt>
        <dd class="col-sm-10">@Model.Formation?.Titre</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Supprimer</button>
        <a asp-action="Index" class="btn btn-secondary">Annuler</a>
    </form>
</div>